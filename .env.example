# Copy to .env and adjust per machine. Never commit .env.

# --- Database -------------------------------------------------------------
# MacBook (Homebrew Postgres 17 + pgvector):
DATABASE_URL=postgresql+psycopg://localhost:5432/lsb_dev
# docker compose sets its own DATABASE_URL for the backend container.
# Letters and digits only: it is embedded in the DB URL (generate: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me

# --- Notes folder (read-only for the app) ---------------------------------
# MacBook: demo data inside the repo. Mac mini: your real notes, e.g. /Users/<you>/Notes
NOTES_DIR=../demo-data
HOST_NOTES_DIR=./demo-data
# Optional: map sources to folders inside NOTES_DIR (e.g. an Obsidian vault).
# Unlisted sources use NOTES_DIR/<source_type>. Journal import stays disabled until Phase 3.
# SOURCE_DIRS={"journal": "<morning-page-folder>", "study": "<study-notes-folder>"}

# --- Model server (OpenAI-compatible) -------------------------------------
# Lemonade default port is 13305. Check with scripts/phase0/check_model_server.sh
LLM_BASE_URL=http://localhost:13305/api/v1
LLM_MODEL=Qwen3.5-9B-GGUF
LLM_DISABLE_THINKING=true

# EMBED_PROVIDER=hash runs fully offline (lexical, for tests/demo without a model server).
EMBED_PROVIDER=openai
EMBED_BASE_URL=http://localhost:13305/api/v1
EMBED_MODEL=Qwen3-Embedding-0.6B-GGUF
# Must match the model's output size BEFORE running migrations (Qwen3-Embedding-0.6B = 1024).
EMBED_DIM=1024

# --- Network ---------------------------------------------------------------
# Address docker publishes the app on. Keep 127.0.0.1, or set the Mac mini's
# Tailscale IP (100.x.y.z) so only your tailnet can reach it. Never 0.0.0.0.
BIND_ADDR=127.0.0.1
